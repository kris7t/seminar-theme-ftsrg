{
  "name": "seminar-theme-ftsrg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "seminar": {},
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "assets"
  ],
  "engines": {
    "node": "^22.22.2 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "seminar preview",
    "present": "seminar present",
    "pdf": "npm run build && seminar pdf",
    "typecheck": "tsc --noEmit",
    "relink": "rm -rf node_modules/@seminar && npm install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@seminar/core": "~0.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/mulish": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@seminar/cli": "file:../seminar/packages/cli",
    "@seminar/core": "file:../seminar/packages/core",
    "@seminar/elements": "file:../seminar/packages/elements",
    "@seminar/mdx": "file:../seminar/packages/mdx",
    "@seminar/plugin-mathjax": "file:../seminar/packages/plugin-mathjax",
    "@seminar/plugin-pele": "file:../seminar/packages/plugin-pele",
    "@seminar/plugin-shiki": "file:../seminar/packages/plugin-shiki",
    "@seminar/rollup-plugin": "file:../seminar/packages/rollup-plugin",
    "@seminar/theme-default": "file:../seminar/packages/theme-default",
    "@seminar/vite-plugin": "file:../seminar/packages/vite-plugin",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@seminar/cli": "$@seminar/cli",
    "@seminar/core": "$@seminar/core",
    "@seminar/elements": "$@seminar/elements",
    "@seminar/mdx": "$@seminar/mdx",
    "@seminar/plugin-mathjax": "$@seminar/plugin-mathjax",
    "@seminar/plugin-pele": "$@seminar/plugin-pele",
    "@seminar/plugin-shiki": "$@seminar/plugin-shiki",
    "@seminar/rollup-plugin": "$@seminar/rollup-plugin",
    "@seminar/theme-default": "$@seminar/theme-default",
    "@seminar/vite-plugin": "$@seminar/vite-plugin"
  }
}
